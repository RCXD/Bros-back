# Test Environment Configuration for apps/test

# API Backend URL
LOCAL_API_BACKEND_URL=http://192.168.1.86:8002
PROD_API_BACKEND_URL=http://192.168.1.86:8002

# Database Configuration
LOCAL_DB_HOST=192.168.1.79
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=404found_test2
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=1234

PROD_DB_HOST=192.168.1.79
PROD_DB_PORT=3306
PROD_DB_NAME=404found_test2
PROD_DB_USER=root
PROD_DB_PASSWORD=1234

# User Generation
LOCAL_NUM_USERS=10
LOCAL_NUM_ADMINS=2

PROD_NUM_USERS=50
PROD_NUM_ADMINS=5

# Image Folders (relative to project root)
LOCAL_PROFILE_IMG_FOLDER=apps/test/uploads/profile_images
LOCAL_POST_IMG_FOLDER=apps/test/uploads/post_images

PROD_PROFILE_IMG_FOLDER=apps/static/profile_images
PROD_POST_IMG_FOLDER=apps/static/post_images

# Dummy Data Directories
LOCAL_DUMMY_DATA_DIR=\\192.168.1.89\share\dummy data
LOCAL_DUMMY_PROFILE_IMG_DIR=\\192.168.1.89\share\dummy data\profile_images
LOCAL_DUMMY_POST_IMG_DIR=\\192.168.1.89\share\dummy data\images

PROD_DUMMY_DATA_DIR=\\192.168.1.89\share\dummy data
PROD_DUMMY_PROFILE_IMG_DIR=\\192.168.1.89\share\dummy data\profile_images
PROD_DUMMY_POST_IMG_DIR=\\192.168.1.89\share\dummy data\images

# Post JSON Path
LOCAL_POST_JSON_PATH=apps/test/json/post_data.json
PROD_POST_JSON_PATH=apps/test/json/post_data.json

# Verbosity Level (0=quiet, 1=normal, 2=verbose)
LOCAL_VERBOSITY=1
PROD_VERBOSITY=1

# Log File Path
LOCAL_LOG_FILE=apps/logs/test.log
PROD_LOG_FILE=apps/logs/test.log
