{
  "module": "product",
  "version": "1.0.0",
  "base_path": "/product",
  "description": "상품 조회 및 관리 API",
  "last_updated": "2025-11-26",

  "endpoints": {
    "상품 목록": {
      "path": "/product",
      "method": "GET",
      "auth_required": false,
      "description": "상품 목록 조회 (페이지네이션, 필터, 정렬 지원)",
      "query_params": {
        "category": { "type": "string", "description": "카테고리 필터 (fishing, motorcycle, car, bicycle, camping)" },
        "search": { "type": "string", "description": "검색어 (상품명, 설명, 브랜드, 모델번호)" },
        "min_price": { "type": "float", "description": "최소 가격" },
        "max_price": { "type": "float", "description": "최대 가격" },
        "sort": { "type": "string", "enum": ["price_asc", "price_desc", "rating_desc", "created_desc", "name_asc"], "default": "created_desc" },
        "page": { "type": "int", "default": 1 },
        "per_page": { "type": "int", "default": 20, "max": 100 },
        "is_active": { "type": "bool", "default": true }
      },
      "response": {
        "items": "Product[]",
        "page": "int",
        "per_page": "int",
        "total": "int",
        "pages": "int",
        "has_next": "bool",
        "has_prev": "bool"
      }
    },

    "상품 상세": {
      "path": "/product/<product_id>",
      "method": "GET",
      "auth_required": false,
      "description": "특정 상품 상세 정보 조회"
    },

    "상품 생성": {
      "path": "/product",
      "method": "POST",
      "auth_required": true,
      "admin_only": true,
      "description": "새 상품 생성 (관리자 전용)",
      "required_fields": ["code", "name", "category", "price"]
    },

    "상품 수정": {
      "path": "/product/<product_id>",
      "method": "PUT",
      "auth_required": true,
      "admin_only": true,
      "description": "상품 정보 수정 (관리자 전용)"
    },

    "상품 삭제": {
      "path": "/product/<product_id>",
      "method": "DELETE",
      "auth_required": true,
      "admin_only": true,
      "description": "상품 비활성화 (소프트 삭제, 관리자 전용)"
    },

    "카테고리 목록": {
      "path": "/product/categories",
      "method": "GET",
      "auth_required": false,
      "description": "카테고리 목록 및 카테고리별 상품 수"
    },

    "상품 검색": {
      "path": "/product/search",
      "method": "GET",
      "auth_required": false,
      "description": "상품 검색 (GET /product와 동일)"
    }
  },

  "metadata_endpoints": {
    "브랜드": {
      "list": {
        "path": "/product/brands",
        "method": "GET",
        "description": "브랜드 목록 조회 (상품 수 포함)",
        "query_params": {
          "search": { "type": "string", "description": "브랜드명 검색" },
          "min_products": { "type": "int", "default": 0, "description": "최소 상품 수 (0이면 전체)" },
          "sort": { "type": "string", "enum": ["product_count", "name", "created"], "default": "product_count" },
          "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
          "page": { "type": "int", "default": 1 },
          "per_page": { "type": "int", "default": 50, "max": 100 }
        },
        "response": {
          "brands": "Brand[]",
          "total": "int"
        }
      },
      "by_id": {
        "path": "/product/brand/<brand_id>",
        "method": "GET",
        "description": "브랜드 ID로 상품 목록 조회"
      },
      "by_slug": {
        "path": "/product/brand/slug/<slug>",
        "method": "GET",
        "description": "브랜드 슬러그로 상품 목록 조회"
      }
    },

    "판매자": {
      "list": {
        "path": "/product/sellers",
        "method": "GET",
        "description": "판매자 목록 조회 (상품 수 포함)",
        "query_params": {
          "search": { "type": "string", "description": "판매자명 검색" },
          "min_products": { "type": "int", "default": 0 },
          "sort": { "type": "string", "enum": ["product_count", "name", "created"], "default": "product_count" },
          "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
          "page": { "type": "int", "default": 1 },
          "per_page": { "type": "int", "default": 50, "max": 100 }
        }
      },
      "by_id": {
        "path": "/product/seller/<seller_id>",
        "method": "GET",
        "description": "판매자 ID로 상품 목록 조회"
      },
      "by_slug": {
        "path": "/product/seller/slug/<slug>",
        "method": "GET",
        "description": "판매자 슬러그로 상품 목록 조회"
      }
    },

    "몰": {
      "list": {
        "path": "/product/malls",
        "method": "GET",
        "description": "몰 목록 조회 (상품 수 포함)",
        "query_params": {
          "search": { "type": "string", "description": "몰 이름 검색" },
          "min_products": { "type": "int", "default": 0 },
          "sort": { "type": "string", "enum": ["product_count", "name", "created"], "default": "product_count" },
          "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
          "page": { "type": "int", "default": 1 },
          "per_page": { "type": "int", "default": 50, "max": 100 }
        }
      },
      "by_id": {
        "path": "/product/mall/<mall_id>",
        "method": "GET",
        "description": "몰 ID로 상품 목록 조회"
      },
      "by_slug": {
        "path": "/product/mall/slug/<slug>",
        "method": "GET",
        "description": "몰 슬러그로 상품 목록 조회"
      }
    }
  },

  "models": {
    "Product": {
      "product_id": "int (PK)",
      "uuid": "string (UUID)",
      "code": "string (고유 상품 코드)",
      "name": "string",
      "description": "text",
      "category": "string",
      "price": "decimal",
      "original_price": "decimal (nullable)",
      "discount_percentage": "int (nullable)",
      "currency": "string (default: 원)",
      "brand": "string (via brand_entity)",
      "seller_name": "string (via seller_entity)",
      "mall_name": "string (via mall_entity)",
      "rating": "decimal (nullable)",
      "n_reviews": "int (nullable)",
      "stock": "int",
      "rocket_delivery": "bool",
      "is_active": "bool",
      "created_at": "datetime",
      "updated_at": "datetime"
    },

    "Brand": {
      "brand_id": "int (PK)",
      "name": "string (unique)",
      "slug": "string (unique, URL-safe)",
      "logo_filename": "string (nullable)",
      "logo_url": "/static/logo_images/<slug>.png"
    },

    "Seller": {
      "seller_id": "int (PK)",
      "name": "string (unique)",
      "slug": "string (unique)",
      "logo_filename": "string (nullable)",
      "logo_url": "/static/logo_images/<slug>.png"
    },

    "Mall": {
      "mall_id": "int (PK)",
      "name": "string (unique)",
      "slug": "string (unique)",
      "logo_filename": "string (nullable)",
      "logo_url": "/static/logo_images/<slug>.png"
    }
  },

  "usage_examples": {
    "인기 브랜드 10개": "GET /product/brands?sort=product_count&order=desc&per_page=10",
    "상품 있는 판매자만": "GET /product/sellers?min_products=1",
    "브랜드명 검색": "GET /product/brands?search=삼성",
    "브랜드별 상품 (가격순)": "GET /product/brand/1?sort=price_asc&page=1",
    "슬러그로 몰 조회": "GET /product/mall/slug/coupang"
  },

  "notes": [
    "모든 메타데이터 엔티티(브랜드/판매자/몰)는 자동 슬러그 생성",
    "로고 이미지는 /static/logo_images/<slug>.png 경로에 저장",
    "상품 수가 0인 메타데이터도 기본 조회됨 (min_products로 필터 가능)",
    "정렬 기본값은 상품 수 내림차순 (인기순)"
  ]
}
