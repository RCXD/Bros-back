# Google Street View Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Kakao Roadview Configuration  
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here  # Optional for web integration

# Naver Street View (Panorama) Configuration
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Optional: Default search radius in meters
ROADVIEW_DEFAULT_RADIUS=50

# Optional: Cache expiration in days
ROADVIEW_CACHE_DAYS=30

# Optional: Enable/disable specific providers
ENABLE_GOOGLE_STREETVIEW=true
ENABLE_KAKAO_ROADVIEW=true
ENABLE_NAVER_STREETVIEW=true