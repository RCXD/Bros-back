# ===================================================================
# API 엔드포인트 중앙 관리 설정
# Python과 JavaScript 모두에서 사용 가능한 형식
# 
# 사용법:
# - Python: python-dotenv로 로드
# - JavaScript: dotenv로 로드
# 
# 백엔드 API 문서 기반 (v1.0, 2025-11-14)
# ===================================================================

# API 버전 선택 (v1 또는 legacy)
API_VERSION=v1

# ===================================================================
# V1 API (최신) - 인증 (Auth)
# Base URL: /auth
# ===================================================================
V1_AUTH_SIGNUP=/auth/user
V1_AUTH_LOGIN=/auth/login
V1_AUTH_LOGOUT=/auth/logout
V1_AUTH_REFRESH=/auth/refresh
V1_AUTH_ME=/auth/me
V1_AUTH_UPDATE=/auth/user
V1_AUTH_DELETE=/auth/user

# 소셜 로그인 (미구현)
V1_AUTH_LOGIN_KAKAO=/auth/login/kakao
V1_AUTH_LOGIN_NAVER=/auth/login/naver
V1_AUTH_LOGIN_GOOGLE=/auth/login/google

# 프로필 이미지
V1_AUTH_IMAGE_UUID=/auth/image/uuid/{filename}
V1_AUTH_IMAGE_USER=/auth/image/user/{user_id}

# ===================================================================
# V1 API - 사용자 (User)
# Base URL: /user
# ===================================================================
V1_USER_PROFILE=/user/{user_id}
V1_USER_FOLLOW=/user/{user_id}/follow
V1_USER_UNFOLLOW=/user/{user_id}/follow
V1_USER_FOLLOWERS=/user/{user_id}/followers
V1_USER_FOLLOWING=/user/{user_id}/following
V1_USER_ADD_FRIEND=/user/{user_id}/friend
V1_USER_REMOVE_FRIEND=/user/{user_id}/friend
V1_USER_MY_FRIENDS=/user/me/friends

# ===================================================================
# V1 API - 게시글 (Post)
# Base URL: /post
# ===================================================================
V1_POST_LIST=/post
V1_POST_CREATE=/post
V1_POST_DETAIL=/post/{post_id}
V1_POST_UPDATE=/post/{post_id}
V1_POST_DELETE=/post/{post_id}
V1_POST_LIKE=/post/{post_id}/like
V1_POST_UNLIKE=/post/{post_id}/like
V1_POST_LIKES=/post/{post_id}/likes
V1_POST_MY_POSTS=/post/me
V1_POST_IMAGES=/post/{post_id}/images
V1_POST_IMAGE=/post/image/{uuid}

# ===================================================================
# V1 API - 댓글 (Reply)
# Base URL: /reply
# ===================================================================
V1_REPLY_LIST=/reply
V1_REPLY_CREATE=/reply
V1_REPLY_DETAIL=/reply/{reply_id}
V1_REPLY_UPDATE=/reply/{reply_id}
V1_REPLY_DELETE=/reply/{reply_id}
V1_REPLY_LIKE=/reply/{reply_id}/like
V1_REPLY_UNLIKE=/reply/{reply_id}/like
V1_REPLY_CHILD_REPLIES=/reply/{reply_id}/replies

# ===================================================================
# V1 API - 피드 (Feed)
# Base URL: /feed
# ===================================================================
V1_FEED_PERSONALIZED=/feed
V1_FEED_TRENDING=/feed/trending
V1_FEED_EXPLORE=/feed/explore
V1_FEED_NEARBY=/feed/nearby

# ===================================================================
# V1 API - 보안 (Security)
# Base URL: /security
# ===================================================================
V1_SECURITY_CREATE_REPORT=/security/reports
V1_SECURITY_MY_REPORTS=/security/reports
V1_SECURITY_REPORT_DETAIL=/security/reports/{report_id}
V1_SECURITY_CANCEL_REPORT=/security/reports/{report_id}

# ===================================================================
# V1 API - 관리자 (Admin)
# Base URL: /admin
# ===================================================================
V1_ADMIN_USERS=/admin/users
V1_ADMIN_USER_DETAIL=/admin/users/{user_id}
V1_ADMIN_BAN_USER=/admin/users/{user_id}/ban
V1_ADMIN_UNBAN_USER=/admin/users/{user_id}/unban
V1_ADMIN_DELETE_USER=/admin/users/{user_id}
V1_ADMIN_STATISTICS=/admin/statistics
V1_ADMIN_ACTIVITY_STATISTICS=/admin/statistics/activity
V1_ADMIN_REPORTS=/admin/reports
V1_ADMIN_RESOLVE_REPORT=/admin/reports/{report_id}/resolve

# ===================================================================
# V1 API - 테스트 (Test)
# Base URL: /test
# ===================================================================
V1_TEST_HEALTH=/test/health
V1_TEST_DB=/test/db
V1_TEST_CONFIG=/test/config
V1_TEST_ERROR=/test/error

# ===================================================================
# Legacy API (구버전) - 인증
# ===================================================================
LEGACY_AUTH_SIGNUP=/auth/sign_up
LEGACY_AUTH_UPDATE=/auth/update
LEGACY_AUTH_LOGIN=/auth/login

# ===================================================================
# Legacy API - 게시글
# ===================================================================
LEGACY_POSTS_LIST=/posts
LEGACY_POSTS_COMMUNITY=/posts/community
LEGACY_POSTS_DETAIL=/posts/{post_id}
LEGACY_POSTS_CREATE=/posts
LEGACY_POSTS_UPDATE=/posts/{post_id}
LEGACY_POSTS_DELETE=/posts/{post_id}
LEGACY_POSTS_IMAGES=/posts/{post_id}/images

# ===================================================================
# Legacy API - 댓글
# ===================================================================
LEGACY_COMMENTS_LIST=/posts/{post_id}/comments
LEGACY_COMMENTS_CREATE=/posts/{post_id}/comments
LEGACY_COMMENTS_UPDATE=/posts/{post_id}/comments/{comment_id}
LEGACY_COMMENTS_DELETE=/posts/{post_id}/comments/{comment_id}
LEGACY_COMMENTS_REPLIES=/posts/{post_id}/comments/{comment_id}/replies

# ===================================================================
# Legacy API - 좋아요
# ===================================================================
LEGACY_LIKES_POST=/posts/{post_id}/likes
LEGACY_LIKES_COMMENT=/posts/{post_id}/comments/{comment_id}/likes

# ===================================================================
# Legacy API - 사용자
# ===================================================================
LEGACY_USERS_PROFILE=/users/{user_id}
LEGACY_USERS_POSTS=/users/{user_id}/posts
LEGACY_USERS_UPDATE_PROFILE=/users/{user_id}/profile

# ===================================================================
# Legacy API - 루트/경로 (미구현)
# ===================================================================
LEGACY_ROUTES_LIST=/routes
LEGACY_ROUTES_DETAIL=/routes/{route_id}
LEGACY_ROUTES_CREATE=/routes
LEGACY_ROUTES_UPDATE=/routes/{route_id}
LEGACY_ROUTES_DELETE=/routes/{route_id}
LEGACY_ROUTES_LIKES=/routes/{route_id}/likes

# ===================================================================
# Legacy API - 스폰서 (미구현)
# ===================================================================
LEGACY_SPONSORS_LIST=/sponsors
LEGACY_SPONSORS_DETAIL=/sponsors/{sponsor_id}
LEGACY_SPONSORS_CREATE=/sponsors
LEGACY_SPONSORS_UPDATE=/sponsors/{sponsor_id}
LEGACY_SPONSORS_DELETE=/sponsors/{sponsor_id}

# ===================================================================
# Legacy API - 기타
# ===================================================================
LEGACY_SEARCH=/search
LEGACY_UPLOAD=/upload
